<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardQuestion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FF161B22"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="#FF21262D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Question header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_question_number"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="1"
                android:textColor="#FF58A6FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="QUESTION"
                android:textColor="#FF8B949E"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <!-- Validation indicator -->
            <View
                android:id="@+id/validationDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_validation_dot_invalid" />

            <ImageButton
                android:id="@+id/btnDeleteQuestion"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete question"
                android:src="@drawable/ic_delete_admin"
                app:tint="#FF6E7681" />
        </LinearLayout>

        <!-- Question text field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuestionText"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Question text"
            app:boxBackgroundColor="#FF0D1117"
            app:boxStrokeColor="#FF30363D"
            app:hintTextColor="#FF8B949E">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="#FFC9D1D9"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Options A–D with radio buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/radioA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="#FF58A6FF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Option A"
                    app:boxBackgroundColor="#FF0D1117"
                    app:boxStrokeColor="#FF30363D"
                    app:hintTextColor="#FF8B949E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOptionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFC9D1D9"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Option B -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/radioB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="#FF58A6FF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Option B"
                    app:boxBackgroundColor="#FF0D1117"
                    app:boxStrokeColor="#FF30363D"
                    app:hintTextColor="#FF8B949E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOptionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFC9D1D9"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Option C -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/radioC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="#FF58A6FF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Option C"
                    app:boxBackgroundColor="#FF0D1117"
                    app:boxStrokeColor="#FF30363D"
                    app:hintTextColor="#FF8B949E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOptionC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFC9D1D9"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Option D -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:buttonTint="#FF58A6FF" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Option D"
                    app:boxBackgroundColor="#FF0D1117"
                    app:boxStrokeColor="#FF30363D"
                    app:hintTextColor="#FF8B949E">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOptionD"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFC9D1D9"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Correct answer hint -->
        <TextView
            android:id="@+id/tvCorrectAnswerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="&#9679; Select the radio button next to the correct answer"
            android:textColor="#FF6E7681"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
