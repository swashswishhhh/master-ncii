<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B5583"
    tools:context=".WorkgroupConfigActivity">

    <!-- ============================================================ -->
    <!-- MAIN CONTENT: Windows "System Properties" dialog              -->
    <!-- ============================================================ -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <!-- ====== WINDOW CARD ====== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#F0F0F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ──── TITLE BAR ──── -->
                    <LinearLayout
                        android:id="@+id/titleBar"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@color/win_title_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <!-- Windows-ish icon -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖥️"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="System Properties"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Window controls (decorative) -->
                        <TextView
                            android:id="@+id/btnWinMinimize"
                            android:layout_width="28dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btnWinMaximize"
                            android:layout_width="28dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="□"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:id="@+id/btnWinClose"
                            android:layout_width="28dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="✕"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:background="@color/win_close_btn" />
                    </LinearLayout>

                    <!-- ──── TAB BAR ──── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="6dp"
                        android:background="#F0F0F0">

                        <!-- Active tab -->
                        <TextView
                            android:id="@+id/tabComputerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Computer Name"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />

                        <!-- Inactive tabs (decorative) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E0E0E0"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginStart="2dp"
                            android:text="Hardware"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E0E0E0"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginStart="2dp"
                            android:text="Advanced"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E0E0E0"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginStart="2dp"
                            android:text="Remote"
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- ──── CONTENT PANEL (white area below tabs) ──── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:layout_marginHorizontal="6dp"
                        android:padding="16dp">

                        <!-- Description row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🖥️"
                                android:textSize="36sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Windows uses the following information to identify your computer on the network."
                                android:textColor="#333333"
                                android:textSize="12sp"
                                android:lineSpacingMultiplier="1.3" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D4D4D4"
                            android:layout_marginBottom="14dp" />

                        <!-- Computer description label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Computer description:"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CSS NC II – Server Configuration Trainer"
                            android:textColor="#666666"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:background="#F5F5F5"
                            android:padding="8dp"
                            android:layout_marginBottom="16dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D4D4D4"
                            android:layout_marginBottom="14dp" />

                        <!-- Full computer name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full computer name:"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etComputerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:padding="8dp"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:text="SERVER-NCII"
                            android:inputType="text"
                            android:singleLine="true"
                            android:importantForAutofill="no"
                            android:layout_marginBottom="16dp"
                            style="@style/Widget.Material3.TextInputEditText.OutlinedBox" />

                        <!-- Workgroup -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workgroup:"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etWorkgroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:padding="8dp"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:text="WORKGROUP"
                            android:inputType="textCapCharacters"
                            android:singleLine="true"
                            android:importantForAutofill="no"
                            android:layout_marginBottom="14dp"
                            style="@style/Widget.Material3.TextInputEditText.OutlinedBox" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D4D4D4"
                            android:layout_marginBottom="10dp" />

                        <!-- Hint text -->
                        <TextView
                            android:id="@+id/tvHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 Task: Change the Workgroup to join your server block.\n\nHint: Your target workgroup name ends with '_B'."
                            android:textColor="@color/win_title_bar"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.4"
                            android:fontFamily="sans-serif"
                            android:padding="10dp"
                            android:background="@color/win_hint_bg" />

                    </LinearLayout>

                    <!-- ──── BUTTON ROW ──── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical"
                        android:padding="10dp"
                        android:background="#F0F0F0">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOk"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="OK"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="3dp"
                            android:minWidth="75dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancel"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:text="Cancel"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="3dp"
                            android:minWidth="75dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnApply"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:text="Apply"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="3dp"
                            android:minWidth="75dp" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instruction label below the window -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Self-Check: Configure Computer Name &amp; Workgroup"
                android:textColor="#AACBEC"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ -->
    <!-- CELEBRATION OVERLAY (hidden by default)                       -->
    <!-- ============================================================ -->

    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimation"
                android:layout_width="220dp"
                android:layout_height="220dp"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_fileName="welcome_celebration.json" />

            <TextView
                android:id="@+id/tvWelcomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Welcome to the Workgroup!"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWelcomeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="You have successfully joined\nWORKGROUP_B"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissOverlay"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Continue"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
