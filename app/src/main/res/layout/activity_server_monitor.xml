<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0F0A"
    tools:context=".ServerMonitorActivity">

    <!-- ══ TOP BAR ══ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FF0D1A0D"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Row 1: mission label + timer pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@color/cyber_neon_green_bright"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="MISSION: SERVER THREAT ANALYSIS"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_timer_pill"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="00:30"
                android:textColor="@color/cyber_neon_green_bright"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task instruction -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3"
            android:text="IDENTIFY THE CRITICAL SERVER. TAP TO ISOLATE."
            android:textColor="@color/cyber_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Integrity bar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="INTEGRITY"
                android:textColor="@color/cyber_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIntegrity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                app:indicatorColor="@color/cyber_neon_green_bright"
                app:trackColor="#1A1A1A"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/tvIntegrityStatus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:letterSpacing="0.08"
                android:text="OPTIMAL"
                android:textColor="@color/cyber_neon_green_bright"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Neon divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0.4"
            android:background="@color/cyber_neon_green" />
    </LinearLayout>

    <!-- ══ STATUS MESSAGE ══ -->
    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="8dp"
        android:text=""
        android:textColor="#FFF44336"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ══ SCROLLABLE SERVER PANELS ══ -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatusMessage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ════════════════════════════════════════ -->
            <!-- SERVER-01  (healthy — all green)         -->
            <!-- ════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServer01"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/monitor_card_normal_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/monitor_ok_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="SERVER-01"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_server_status_ok"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="ONLINE"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CPU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="CPU"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS01Cpu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="45"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="45%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- RAM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="RAM"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS01Ram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="60"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="60%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- DISK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="DISK"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS01Disk"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="30"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="30%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════ -->
            <!-- SERVER-02  (CRITICAL — all red)          -->
            <!-- ════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServer02"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/monitor_card_critical_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/monitor_critical_red"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="SERVER-02"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvServer02StatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_server_status_critical"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="⚠ CRITICAL"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CPU — animated -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="CPU"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS02Cpu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="92"
                            app:indicatorColor="@color/monitor_critical_red"
                            app:trackColor="#33FF3B3B"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="92%"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- RAM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="RAM"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS02Ram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="88"
                            app:indicatorColor="@color/monitor_critical_red"
                            app:trackColor="#33FF3B3B"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="88%"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- DISK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="DISK"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS02Disk"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="95"
                            app:indicatorColor="@color/monitor_critical_red"
                            app:trackColor="#33FF3B3B"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="95%"
                            android:textColor="@color/monitor_critical_red"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════ -->
            <!-- SERVER-03  (healthy — all green)         -->
            <!-- ════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServer03"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/monitor_card_normal_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/monitor_ok_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="SERVER-03"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_server_status_ok"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="ONLINE"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- CPU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="CPU"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS03Cpu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="20"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="20%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- RAM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="RAM"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS03Ram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="40"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="40%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- DISK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="DISK"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressS03Disk"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="55"
                            app:indicatorColor="@color/monitor_ok_green"
                            app:trackColor="#1A39FF7F"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="55%"
                            android:textColor="@color/monitor_ok_green"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SUCCESS OVERLAY                                            -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/overlaySuccess"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EE0A0F0A"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tvSuccessIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✔"
                android:textColor="@color/cyber_neon_green"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="THREAT NEUTRALIZED"
                android:textColor="@color/cyber_neon_green"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSuccessSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="SERVER-02 ISOLATED SUCCESSFULLY\nSYSTEMS SECURED"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/cyber_neon_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
