<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <!-- ══════════════════════════════════════════════════════════
         TOOLBAR
    ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F0F1A"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0F0F1A"
            app:title="⬡ NEW MISSION"
            app:titleTextColor="#FFE600"
            app:navigationIcon="@drawable/ic_arrow_back"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════════════════════
         SCROLLABLE CONTENT
    ══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ─── STEP INDICATOR PILLS ─────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <View
                    android:id="@+id/pill1"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#FFE600"/>

                <View
                    android:id="@+id/pill2"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="#1E1E3A"/>

                <View
                    android:id="@+id/pill3"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#1E1E3A"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════
                 STEP 1 — MISSION INFO
            ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sectionMissionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// TARGET CHAPTER"
                    android:textColor="#6B6B99"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#12121F"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHAPTER"
                            android:textColor="#6B6B99"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerChapter"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="#1E1E3A"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- // MISSION DATA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// MISSION DATA"
                    android:textColor="#6B6B99"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#12121F"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Mission Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MISSION TITLE"
                            android:textColor="#6B6B99"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:boxStrokeColor="#1E1E3A"
                            app:hintTextColor="#6B6B99">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMissionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. VPN Basics"
                                android:textColor="#E8E8FF"
                                android:fontFamily="monospace"
                                android:inputType="text"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ── MISSION ID (AUTO-FILLED) ───────────────── -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MISSION ID"
                                android:textColor="#6B6B99"
                                android:textSize="10sp"
                                android:fontFamily="monospace"/>

                            <!-- Badge: AUTO-FILLED -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⬡ AUTO-FILLED"
                                android:textColor="#00FF9F"
                                android:textSize="9sp"
                                android:fontFamily="monospace"
                                android:background="#0D1F14"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"/>

                        </LinearLayout>

                        <!-- Mission ID input — editable but pre-filled -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            app:boxStrokeColor="#00FF9F"
                            app:hintTextColor="#6B6B99"
                            app:startIconDrawable="@drawable/ic_lock"
                            app:startIconTint="#00FF9F">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMissionId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Fetching next ID..."
                                android:textColor="#00FF9F"
                                android:fontFamily="monospace"
                                android:inputType="text"
                                android:textStyle="bold"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Hint label — shown after autofill -->
                        <TextView
                            android:id="@+id/tvMissionIdHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#4A7A5A"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone"/>

                        <!-- Description -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DESCRIPTION (OPTIONAL)"
                            android:textColor="#6B6B99"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:boxStrokeColor="#1E1E3A"
                            app:hintTextColor="#6B6B99">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Brief description of this mission"
                                android:textColor="#E8E8FF"
                                android:fontFamily="monospace"
                                android:inputType="textMultiLine"
                                android:minLines="2"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Difficulty -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIFFICULTY"
                            android:textColor="#6B6B99"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerDifficulty"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="#1E1E3A"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Step 1 → Next -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    android:text="NEXT — ADD QUESTIONS  →"
                    android:fontFamily="monospace"
                    android:textColor="#0A0A0F"
                    android:textSize="13sp"
                    app:backgroundTint="#FFE600"
                    app:cornerRadius="4dp"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════
                 STEP 2 — ADD QUESTIONS INLINE
            ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sectionAddQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#0F1A2A"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#00F5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvContextBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Chapter 1 › Mission"
                            android:textColor="#00F5FF"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:ellipsize="end"
                            android:maxLines="1"/>

                        <TextView
                            android:id="@+id/tvQuestionCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 questions added"
                            android:textColor="#6B6B99"
                            android:textSize="11sp"
                            android:fontFamily="monospace"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:chipSpacingHorizontal="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// QUESTION DATA"
                    android:textColor="#6B6B99"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#12121F"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#00F5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Question Text"
                            android:textColor="#00F5FF"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="#0F0F1A"
                            app:boxStrokeColor="#00F5FF"
                            app:hintTextColor="#6B6B99">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etQText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="72dp"
                                android:gravity="top|start"
                                android:inputType="textMultiLine"
                                android:textColor="#E8E8FF"
                                android:fontFamily="monospace"
                                android:textSize="14sp"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choice A" android:textColor="#00F5FF" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:boxBackgroundColor="#0F0F1A" app:boxStrokeColor="#00F5FF">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQChoiceA" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8E8FF" android:fontFamily="monospace" android:textSize="14sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choice B" android:textColor="#00F5FF" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:boxBackgroundColor="#0F0F1A" app:boxStrokeColor="#00F5FF">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQChoiceB" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8E8FF" android:fontFamily="monospace" android:textSize="14sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choice C" android:textColor="#00F5FF" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:boxBackgroundColor="#0F0F1A" app:boxStrokeColor="#00F5FF">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQChoiceC" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8E8FF" android:fontFamily="monospace" android:textSize="14sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choice D" android:textColor="#00F5FF" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundColor="#0F0F1A" app:boxStrokeColor="#00F5FF">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQChoiceD" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8E8FF" android:fontFamily="monospace" android:textSize="14sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="// ANSWER CONFIG" android:textColor="#6B6B99" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#12121F"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFE600"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Correct Answer" android:textColor="#FFE600" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                        <RadioGroup
                            android:id="@+id/rgCorrectAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">
                            <RadioButton android:id="@+id/rbAnswerA" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="A" android:textColor="#E8E8FF" android:fontFamily="monospace" android:buttonTint="#FFE600"/>
                            <RadioButton android:id="@+id/rbAnswerB" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="B" android:textColor="#E8E8FF" android:fontFamily="monospace" android:buttonTint="#FFE600"/>
                            <RadioButton android:id="@+id/rbAnswerC" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="C" android:textColor="#E8E8FF" android:fontFamily="monospace" android:buttonTint="#FFE600"/>
                            <RadioButton android:id="@+id/rbAnswerD" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" android:textColor="#E8E8FF" android:fontFamily="monospace" android:buttonTint="#FFE600"/>
                        </RadioGroup>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Difficulty" android:textColor="#FFE600" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <Spinner android:id="@+id/spinnerQDifficulty" android:layout_width="match_parent" android:layout_height="48dp" android:background="#1E1E3A" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginBottom="16dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explanation (Optional)" android:textColor="#FFE600" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundColor="#0F0F1A" app:boxStrokeColor="#FFE600">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etQExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine" android:textColor="#E8E8FF" android:fontFamily="monospace" android:textSize="14sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="+ SAVE &amp; ADD ANOTHER"
                    android:fontFamily="monospace"
                    android:textColor="#0A0A0F"
                    android:textSize="13sp"
                    app:backgroundTint="#00F5FF"
                    app:cornerRadius="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoneQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:text="DONE — REVIEW MISSION  →"
                    android:fontFamily="monospace"
                    android:textColor="#FFE600"
                    android:textSize="13sp"
                    android:enabled="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#FFE600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="4dp"/>

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════
                 STEP 3 — REVIEW & PUBLISH
            ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sectionReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="// MISSION SUMMARY" android:textColor="#6B6B99" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#12121F"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFE600"
                    app:strokeWidth="1dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="CHAPTER" android:textColor="#6B6B99" android:textSize="10sp" android:fontFamily="monospace"/>
                            <TextView android:id="@+id/tvReviewChapter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="#E8E8FF" android:textSize="13sp" android:fontFamily="monospace"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="TITLE" android:textColor="#6B6B99" android:textSize="10sp" android:fontFamily="monospace"/>
                            <TextView android:id="@+id/tvReviewTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="#FFE600" android:textSize="13sp" android:fontFamily="monospace"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="ID" android:textColor="#6B6B99" android:textSize="10sp" android:fontFamily="monospace"/>
                            <TextView android:id="@+id/tvReviewMissionId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="#00FF9F" android:textSize="13sp" android:fontFamily="monospace"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="DIFFICULTY" android:textColor="#6B6B99" android:textSize="10sp" android:fontFamily="monospace"/>
                            <TextView android:id="@+id/tvReviewDifficulty" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="#E8E8FF" android:textSize="13sp" android:fontFamily="monospace"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E3A" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>

                        <TextView android:id="@+id/tvReviewQuestionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 questions ready" android:textColor="#00F5FF" android:textSize="15sp" android:fontFamily="monospace" android:textStyle="bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPublishMission"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="⬡  PUBLISH MISSION"
                    android:fontFamily="monospace"
                    android:textColor="#0A0A0F"
                    android:textSize="13sp"
                    app:backgroundTint="#FFE600"
                    app:cornerRadius="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDraft"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="24dp"
                    android:text="SAVE AS DRAFT"
                    android:fontFamily="monospace"
                    android:textColor="#6B6B99"
                    android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#6B6B99"
                    app:strokeWidth="1dp"
                    app:cornerRadius="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- LOADING OVERLAY -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A0F"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#FFE600"/>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>