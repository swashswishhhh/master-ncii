<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <!-- ═══ App Bar ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?colorSurface"
            app:title="PROFILE"
            app:titleTextColor="?colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?colorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ Loading overlay ═══ -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- ═══ Main Content ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECTION 1: IDENTITY CARD                        -->
            <!-- ═══════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="?colorPrimary"
                app:cardBackgroundColor="?colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="// OPERATIVE IDENTITY"
                        android:textSize="11sp"
                        android:textColor="?colorPrimary"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="16dp" />

                    <!-- Avatar row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Avatar circle -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="36dp"
                            app:strokeWidth="2dp"
                            app:strokeColor="?colorPrimary"
                            app:cardBackgroundColor="?colorSurface">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_person"
                                android:padding="16dp"
                                app:tint="?colorPrimary"
                                android:scaleType="centerInside"
                                android:contentDescription="Avatar" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Name and email -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvDisplayName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OPERATIVE"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="?colorOnSurface" />

                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="user@email.com"
                                android:textSize="12sp"
                                android:textColor="?colorOnSurfaceVariant"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tvAccountType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="[ AUTHENTICATED ]"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="?colorPrimary"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Edit name button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditName"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="✎  EDIT DISPLAY NAME"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECTION 2: RANK                                 -->
            <!-- ═══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// CLEARANCE LEVEL"
                android:textSize="11sp"
                android:textColor="?colorPrimary"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:paddingBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="?colorPrimary"
                app:cardBackgroundColor="?colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <!-- Rank icon -->
                    <TextView
                        android:id="@+id/tvRankIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="□"
                        android:textSize="48sp"
                        android:fontFamily="monospace"
                        android:textColor="?colorPrimary" />

                    <!-- Rank title -->
                    <TextView
                        android:id="@+id/tvRankTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECRUIT"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="?colorOnSurface"
                        android:layout_marginTop="8dp" />

                    <!-- Rank hint -->
                    <TextView
                        android:id="@+id/tvRankHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reach 20% mastery to rank up"
                        android:textSize="12sp"
                        android:textColor="?colorOnSurfaceVariant"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECTION 3: STATS                                -->
            <!-- ═══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// PERFORMANCE METRICS"
                android:textSize="11sp"
                android:textColor="?colorPrimary"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:paddingBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="?colorPrimary"
                app:cardBackgroundColor="?colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Skill Points + Missions row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <!-- Skill Points -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvSkillPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="?colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SKILL POINTS"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="?colorOnSurfaceVariant"
                                android:letterSpacing="0.08" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?colorOutline"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp" />

                        <!-- Missions Completed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvMissionsCompleted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 21"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textColor="?colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MISSIONS DONE"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:textColor="?colorOnSurfaceVariant"
                                android:letterSpacing="0.08" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Overall Mastery label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OVERALL MASTERY"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="?colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvOverallMastery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="?colorPrimary" />

                    </LinearLayout>

                    <!-- Mastery progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressMastery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"
                        app:indicatorColor="?colorPrimary"
                        app:trackColor="?colorSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECTION 4: ACTIONS                              -->
            <!-- ═══════════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="// SYSTEM ACTIONS"
                android:textSize="11sp"
                android:textColor="?colorPrimary"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:paddingStart="4dp"
                android:paddingBottom="8dp" />

            <!-- Sync progress button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncProgress"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="⟳  SYNC PROGRESS"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <!-- Logout button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="⏻  TERMINATE SESSION"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:backgroundTint="#FFCC0000"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>