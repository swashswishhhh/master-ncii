<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0F0A"
    tools:context=".PermissionSimulatorActivity">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- HEADER                                                     -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FF0D1A0D"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="monospace"
                android:padding="4dp"
                android:text="◀ BACK"
                android:textColor="@color/cyber_neon_green"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAttempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ATTEMPTS: 0"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="[ MISSION: ACCESS CONTROL ]"
            android:textColor="@color/cyber_neon_green"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3"
            android:text="ASSIGN NTFS PERMISSIONS TO EACH USER ROLE"
            android:textColor="@color/cyber_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="▸ DRAG a permission badge onto a user card"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0.4"
            android:background="@color/cyber_neon_green" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- STATUS MESSAGE (wrong submission feedback)                 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="8dp"
        android:text=""
        android:textColor="#FFF44336"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SCROLLABLE CONTENT: badge tray + user cards               -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatusMessage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ── PERMISSION BADGE TRAY ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBadgeTray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FF0D1A0D"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/cyber_neon_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:text="▸ PERMISSION BADGES"
                        android:textColor="@color/cyber_neon_green"
                        android:textSize="11sp" />

                    <!-- Badge row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Full Control badge -->
                        <TextView
                            android:id="@+id/badgeFullControl"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_badge_full_control"
                            android:elevation="6dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="Full Control"
                            android:textColor="@color/cyber_neon_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Change badge -->
                        <TextView
                            android:id="@+id/badgeChange"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_badge_change"
                            android:elevation="6dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="Change"
                            android:textColor="@color/cyber_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Read badge -->
                        <TextView
                            android:id="@+id/badgeRead"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="6dp"
                            android:background="@drawable/bg_badge_read"
                            android:elevation="6dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp"
                            android:text="Read"
                            android:textColor="@color/cyber_gold"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="Badges can be reused — drag to each user card"
                        android:textColor="@color/cyber_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── USER ROLE CARDS ── -->

            <!-- IT Admin -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardItAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/cyber_card_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/cyber_neon_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Role icon + name -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="🖥"
                            android:textSize="28sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="IT Admin"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="System Administrator"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Drop zone -->
                    <TextView
                        android:id="@+id/dropZoneItAdmin"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_drop_zone_idle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="DROP HERE"
                        android:textColor="@color/cyber_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accountant -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccountant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/cyber_card_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/cyber_neon_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="💼"
                            android:textSize="28sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="Accountant"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Finance Department"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dropZoneAccountant"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_drop_zone_idle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="DROP HERE"
                        android:textColor="@color/cyber_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Intern -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIntern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/cyber_card_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/cyber_neon_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="🎓"
                            android:textSize="28sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="Intern"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Trainee / Limited Access"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dropZoneIntern"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_drop_zone_idle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="DROP HERE"
                        android:textColor="@color/cyber_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HR Manager -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHrManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/cyber_card_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/cyber_neon_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="👥"
                            android:textSize="28sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="HR Manager"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Human Resources"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dropZoneHrManager"
                        android:layout_width="110dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_drop_zone_idle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="DROP HERE"
                        android:textColor="@color/cyber_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- BOTTOM BAR — SUBMIT button                                 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FF0D1A0D"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            android:background="@color/cyber_neon_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:enabled="false"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:text="▶  SUBMIT PERMISSIONS"
            android:textColor="#FF0A0F0A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cyber_text_muted"
            app:cornerRadius="6dp"
            app:rippleColor="#4D000000" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SUCCESS OVERLAY                                            -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/overlaySuccess"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EE0A0F0A"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tvSuccessIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✔"
                android:textColor="@color/cyber_neon_green"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="ACCESS GRANTED"
                android:textColor="@color/cyber_neon_green"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSuccessSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="NTFS PERMISSIONS CORRECTLY\nASSIGNED TO ALL USERS"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/cyber_neon_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:minWidth="200dp"
                android:text="▶  CONTINUE"
                android:textColor="#FF0A0F0A"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cyber_neon_green"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
