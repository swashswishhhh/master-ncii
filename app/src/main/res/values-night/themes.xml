<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — dark variant. -->
    <style name="Base.Theme.ServerMasterNCII" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Cyber Dark Mode color overrides -->
        <item name="colorPrimary">@color/cyber_neon_green</item>
        <item name="colorOnPrimary">@color/cyber_bg_primary</item>
        <item name="colorPrimaryContainer">@color/cyber_neon_green_dim</item>
        <item name="colorOnPrimaryContainer">@color/cyber_neon_green</item>
        <item name="android:colorBackground">@color/cyber_bg_primary</item>
        <item name="colorSurface">@color/cyber_bg_surface</item>
        <item name="colorOnSurface">@color/cyber_text_primary</item>
        <item name="colorSurfaceVariant">@color/cyber_bg_card</item>
        <item name="colorOnSurfaceVariant">@color/cyber_text_secondary</item>

        <!-- Status bar colour -->
        <item name="android:statusBarColor">@color/cyber_bg_primary</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>