<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/bg_progress_track.xml
    Dark pill-shaped track that sits behind the splash loading bar.
    Apply as android:background on the FrameLayout wrapping the ProgressBar.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1E1E3A" />
    <corners android:radius="2dp" />
</shape>