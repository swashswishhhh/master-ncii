<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A39FF7F" />
            <stroke android:width="1dp" android:color="#FF39FF7F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A39FF7F" />
            <stroke android:width="1dp" android:color="#8839FF7F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
