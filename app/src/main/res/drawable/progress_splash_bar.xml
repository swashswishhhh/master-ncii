<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/progress_splash_bar.xml
    Custom progress drawable for the splash loading bar.
    Fills left-to-right with a cyan (#00F5FF) → yellow (#FFE600) gradient.
    Set as android:progressDrawable on the ProgressBar in activity_splash.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background track (transparent — bg_progress_track on the parent handles it) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Secondary progress (unused — keep transparent) -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#00000000" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>

    <!-- Primary progress fill — cyan → yellow gradient with glow effect -->
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <layer-list>
                <!-- Main gradient fill -->
                <item>
                    <shape android:shape="rectangle">
                        <gradient
                            android:type="linear"
                            android:angle="0"
                            android:startColor="#00F5FF"
                            android:centerColor="#80FFE600"
                            android:endColor="#FFE600" />
                        <corners android:radius="2dp" />
                    </shape>
                </item>
                <!-- Bright highlight line on top edge for depth -->
                <item android:bottom="2dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#33FFFFFF" />
                        <corners android:radius="2dp" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>

</layer-list>