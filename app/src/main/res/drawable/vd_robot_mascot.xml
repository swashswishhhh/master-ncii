        android:pathData="M46,58 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#1E1E3A"
        android:strokeColor="#00F5FF"
        android:strokeWidth="1.5"/>
    <path
        android:pathData="M114,58 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#1E1E3A"
        android:strokeColor="#00F5FF"
