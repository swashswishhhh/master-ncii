    <!-- ── Head ── -->
    <path
        android:pathData="M46,34 Q46,34 46,48 L46,72 Q46,86 60,86 L100,86 Q114,86 114,72 L114,48 Q114,34 100,34 Z"
        android:fillColor="#12122A"
        android:strokeColor="#00F5FF"
