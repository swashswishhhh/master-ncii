<?xml version="1.0" encoding="utf-8"?>
<!--
    vd_robot_mascot.xml — VectorDrawable (static robot)
    Place in: res/drawable/vd_robot_mascot.xml

    Named groups/paths that avd_robot_mascot.xml targets:
      eyeLeft, eyeRight  — eye rectangles (blink via scaleY)
      antennaLight       — top antenna dot (alpha pulse)
      mouth              — smile rect (scaleY wiggle)
      chestScan          — horizontal scan line (translateY)
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="160"
    android:viewportHeight="160">

    <!-- ── Soft glow halo (behind everything) ── -->
    <path
        android:pathData="M80,80 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0"
        android:fillColor="#00F5FF"
        android:fillAlpha="0.07"/>

    <!-- ── Antenna pole ── -->
    <path
        android:name="antennaPole"
        android:pathData="M80,20 L80,34"
        android:strokeColor="#00F5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- ── Antenna light ── -->
    <group android:name="antennaLight"
        android:pivotX="80" android:pivotY="16">
        <path
            android:pathData="M80,16 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
            android:fillColor="#FFE600"
            android:fillAlpha="1"/>
        <!-- tiny inner white shine -->
        <path
            android:pathData="M78,14 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.7"/>
